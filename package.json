{
  "name": "mcp-server-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A small local (stdio) Model Context Protocol server template to put in front of an API you already have.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-template": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "example:api": "tsx src/example/api/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
